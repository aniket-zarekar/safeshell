# Git ignore

# Operating system files
.DS_Store
Thumbs.db

# Environment and secrets
.env
.env.*
!.env.example
*.pem
*.key
*.crt

# Python
__pycache__/
*.py[cod]
venv/
.venv/
venv*

# Node
node_modules/
.npm/

# Logs
*.log
logs/

# Editor settings
.vscode/
.idea/
*.swp
*.swo

# Build artifacts
dist/
build/
coverage/

# Temporary files
tmp/
temp/
*.tmp
